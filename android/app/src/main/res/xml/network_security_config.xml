<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS obligatorio, excepto el backend local de la Mac: desde el emulador
     (10.0.2.2, build:mobile) y desde un teléfono real por el Wi-Fi de la oficina
     (IP de la Mac, modo mobile-device). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">172.16.68.60</domain>
    </domain-config>
</network-security-config>
